+class RayTransportWorker(Worker):
+    """CPU producer/consumer that rejects collective communication."""
+
+    def send(self, *args, **kwargs):
+        raise AssertionError("Ray transport must not invoke Worker.send")
+
+    def recv(self, *args, **kwargs):
+        raise AssertionError("Ray transport must not invoke Worker.recv")
+
+    def produce(self, channel, mode):
+        payload = {"tensor": torch.arange(4), "label": "CPU payload"}
+        if mode == "nowait":
+            channel.put_nowait(payload, weight=1, key="test")
+        elif mode == "async":
+            channel.put(payload, weight=1, key="test", async_op=True).wait()
+        else:
+            channel.put(payload, weight=1, key="test")
+
+    def consume(self, channel, mode, reconnect=False):
+        if reconnect:
+            channel = self.connect_channel(channel, transport="ray")
+        if mode == "nowait":
+            payload = channel.get_nowait(key="test")
+        elif mode == "async":
+            payload = channel.get(key="test", async_op=True).wait()
+        elif mode == "batch":
+            payload = channel.get_batch(target_weight=1, key="test")[0]
+        else:
+            payload = channel.get(key="test")
+        return (
+            payload["tensor"].tolist(),
+            payload["tensor"].device.type,
+            payload["label"],
+        )
+
+    def check_empty(self, channel):
+        with pytest.raises(asyncio.QueueEmpty):
+            channel.get_nowait(key="empty")
+        return True
+
+
+class TestRayChannelTransport:
+    """Exercise Ray payloads through real CPU Workers and named reconnection."""
+
+    @pytest.fixture(autouse=True)
+    def stub_manager(self):
+        """Use the real manager for actor-based transport tests."""
+
+    @pytest.fixture(scope="class")
+    def cpu_workers(self, cluster):
+        placement = NodePlacementStrategy([0])
+        producer = RayTransportWorker.create_group().launch(
+            cluster,
+            name=f"ray_producer_{uuid.uuid4().hex}",
+            placement_strategy=placement,
+        )
+        consumer = RayTransportWorker.create_group().launch(
+            cluster,
+            name=f"ray_consumer_{uuid.uuid4().hex}",
+            placement_strategy=placement,
+        )
+        return producer, consumer
+
+    @pytest.mark.parametrize("mode", ["sync", "async", "nowait", "batch"])
+    def test_cpu_payload_inside_workers(self, cpu_workers, mode):
+        producer, consumer = cpu_workers
+        channel = Channel.create(
+            name=f"ray_payload_{uuid.uuid4().hex}", transport="ray"
+        )
+        producer.produce(channel, mode).wait()
+        assert consumer.consume(channel, mode).wait()[0] == (
+            [0, 1, 2, 3],
+            "cpu",
+            "CPU payload",
+        )
+        assert consumer.check_empty(channel).wait()[0]
+
+    def test_duplicate_creation_and_named_reconnection(self, cpu_workers):
+        producer, consumer = cpu_workers
+        name = f"ray_reconnect_{uuid.uuid4().hex}"
+        original = Channel.create(name=name, transport="ray")
+        assert original.qsize() == 0
+        reconnected = Channel.create(name=name, transport="ray")
+        producer.produce(reconnected, "sync").wait()
+        assert consumer.consume(name, "sync", reconnect=True).wait()[0] == (
+            [0, 1, 2, 3],
+            "cpu",
+            "CPU payload",
+        )
+
+    def test_invalid_transport(self):
+        with pytest.raises(ValueError, match="Unsupported channel transport"):
+            Channel.create(name="invalid", transport="unknown")
+        with pytest.raises(ValueError, match="Ray transport cannot"):
+            Channel.create(name="invalid", local=True, transport="ray")
+        with pytest.raises(ValueError, match="Unsupported channel transport"):
+            Channel.connect(name="invalid", current_worker=None, transport="unknown")
+
+
+@pytest.mark.parametrize("batch", [False, True])
+def test_ray_get_preserves_dispatcher_consumer_routing(batch):
+    async def run():
+        worker = _stub_worker(dispatcher="round_robin")
+        for index in range(6):
+            await worker.put_via_ray(index, weight=1, key="k")
+        if batch:
+            return await worker.get_batch_via_ray(
+                target_weight=2, key="k", consumer="actor:1"
+            )
+        first = await worker.get_via_ray(key="k", consumer="actor:1")
+        second = await worker.get_via_ray(key="k", nowait=True, consumer="actor:1")
+        with pytest.raises(asyncio.QueueEmpty):
+            await worker.get_via_ray(key="k", nowait=True, consumer="actor:1")
+        return [first, second]
+
+    assert asyncio.run(run()) == [1, 4]
