+
+"""Actual CPU/Gloo checkpoint control flow, separate from MUSA/FSDP coverage.
+
+The model is a real ordinary CPU module, not a substitute for GPU FSDP. Only
+GPU cache housekeeping is replaced with CPU gc.collect; stateful checkpoint
+save/load, DCP, Gloo, AdamW, StepLR and CPU RNG operations are executed normally.
+"""
+
+import copy
+import gc
+import random
+from collections.abc import Mapping
+
+import numpy as np
+import pytest
+import torch
+import torch.distributed as dist
+
+import rlinf.hybrid_engines.fsdp.strategy.base as strategy_base
+from rlinf.hybrid_engines.fsdp.strategy.fsdp import FSDPStrategy
+from rlinf.scheduler import Worker
+from rlinf.utils.utils import get_rng_state, warmup_optimizer_state
+
+
+@pytest.fixture
+def cpu_checkpoint_group(tmp_path, monkeypatch):
+    monkeypatch.setattr(Worker, "torch_device_type", "cpu")
+    # get_rng_state must not inspect the installed machine's accelerator.
+    monkeypatch.setattr(Worker, "torch_platform", None)
+    monkeypatch.setattr(strategy_base, "clear_memory", gc.collect)
+    assert not dist.is_initialized()
+    dist.init_process_group(
+        backend="gloo",
+        rank=0,
+        world_size=1,
+        init_method=f"file://{tmp_path / 'rendezvous'}",
+    )
+    try:
+        yield
+    finally:
+        dist.destroy_process_group()
+
+
+def assert_equal_tree(actual, expected):
+    if isinstance(expected, torch.Tensor):
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    elif isinstance(expected, np.ndarray):
+        np.testing.assert_array_equal(actual, expected)
+    elif isinstance(expected, Mapping):
+        assert actual.keys() == expected.keys()
+        for key in expected:
+            assert_equal_tree(actual[key], expected[key])
+    elif isinstance(expected, (list, tuple)):
+        assert type(actual) is type(expected)
+        assert len(actual) == len(expected)
+        for index in range(len(expected)):
+            assert_equal_tree(actual[index], expected[index])
+    else:
+        assert actual == expected
+
+
+def make_model():
+    return torch.nn.Sequential(
+        torch.nn.Linear(3, 8), torch.nn.Tanh(), torch.nn.Linear(8, 2)
+    )
+
+
+def training_state(model, optimizer, scheduler):
+    return copy.deepcopy(
+        {
+            "model": model.state_dict(),
+            "optimizer": optimizer.state_dict(),
+            "scheduler": scheduler.state_dict(),
+        }
+    )
+
+
+def update(model, optimizer, scheduler, inputs, targets):
+    optimizer.zero_grad(set_to_none=True)
+    loss = 16 * (model(inputs) - targets).square().mean()
+    loss.backward()
+    norm = float(torch.nn.utils.clip_grad_norm_(model.parameters(), 0.25))
+    assert norm > 0.25
+    optimizer.step()
+    scheduler.step()
+    optimizer.zero_grad(set_to_none=True)
+
+
+def rng_samples():
+    return {
+        "python": [random.random() for _ in range(4)],
+        "numpy": np.random.rand(4),
+        "torch_cpu": torch.rand(4),
+    }
+
+
+@pytest.mark.parametrize("checkpoint_format", ["local_shard", "dcp"])
+def test_cpu_checkpoint_restores_momentum_scheduler_rng_and_next_update(
+    cpu_checkpoint_group, tmp_path, checkpoint_format
+):
+    torch.manual_seed(42)
+    np.random.seed(43)
+    random.seed(44)
+    model = make_model()
+    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-3)
+    scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=1, gamma=0.9)
+    inputs = [torch.randn(8, 3), torch.randn(8, 3)]
+    targets = [torch.randn(8, 2), torch.randn(8, 2)]
+    update(model, optimizer, scheduler, inputs[0], targets[0])
+    saved = training_state(model, optimizer, scheduler)
+    assert any(
+        bool(value["exp_avg"].abs().sum() > 0)
+        for value in saved["optimizer"]["state"].values()
+    )
+    saved_rng = copy.deepcopy(get_rng_state())
+    assert set(saved_rng) == {"cpu", "numpy", "random"}
+    checkpoint_dir = tmp_path / checkpoint_format
+    FSDPStrategy.save_checkpoint(
+        model,
+        optimizer,
+        scheduler,
+        str(checkpoint_dir),
+        save_full_model_weights=False,
+        checkpoint_format=checkpoint_format,
+    )
+    assert_equal_tree(training_state(model, optimizer, scheduler), saved)
+    assert_equal_tree(get_rng_state(), saved_rng)
+    expected_samples = rng_samples()
+    update(model, optimizer, scheduler, inputs[1], targets[1])
+    expected = training_state(model, optimizer, scheduler)
+    expected_end_rng = copy.deepcopy(get_rng_state())
+
+    rebuilt = make_model()
+    assert rebuilt is not model
+    assert {id(value) for value in rebuilt.parameters()}.isdisjoint(
+        {id(value) for value in model.parameters()}
+    )
+    rebuilt_optimizer = torch.optim.AdamW(rebuilt.parameters(), lr=1e-3)
+    rebuilt_scheduler = torch.optim.lr_scheduler.StepLR(
+        rebuilt_optimizer, step_size=1, gamma=0.9
+    )
+    assert not rebuilt_optimizer.state
+    assert all(value.grad is None for value in rebuilt.parameters())
+    before_warmup = copy.deepcopy(rebuilt.state_dict())
+    warmup_optimizer_state(rebuilt_optimizer)
+    assert_equal_tree(rebuilt.state_dict(), before_warmup)
+    assert len(rebuilt_optimizer.state) == len(list(rebuilt.parameters()))
+    assert all(
+        float(value["step"]) == 0
+        and bool(value["exp_avg"].eq(0).all())
+        and bool(value["exp_avg_sq"].eq(0).all())
+        for value in rebuilt_optimizer.state.values()
+    )
+    FSDPStrategy.load_checkpoint(
+        rebuilt,
+        rebuilt_optimizer,
+        rebuilt_scheduler,
+        str(checkpoint_dir),
+        checkpoint_format=checkpoint_format,
+    )
+    assert_equal_tree(
+        training_state(rebuilt, rebuilt_optimizer, rebuilt_scheduler), saved
+    )
+    assert_equal_tree(get_rng_state(), saved_rng)
+    assert_equal_tree(rng_samples(), expected_samples)
+    update(rebuilt, rebuilt_optimizer, rebuilt_scheduler, inputs[1], targets[1])
+    assert_equal_tree(
+        training_state(rebuilt, rebuilt_optimizer, rebuilt_scheduler), expected
+    )
+    assert_equal_tree(get_rng_state(), expected_end_rng)
+    if checkpoint_format == "dcp":
+        assert (checkpoint_dir / "dcp_checkpoint" / ".metadata").is_file()
+        assert list((checkpoint_dir / "dcp_checkpoint").glob("*.distcp"))
+    else:
+        assert (
+            checkpoint_dir / "local_shard_checkpoint" / "checkpoint_rank_0.pt"
+        ).is_file()
