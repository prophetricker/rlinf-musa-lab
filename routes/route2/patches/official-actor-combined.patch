@@ -0,0 +1,39 @@
+"""Explicit single-Actor/single-Rollout CPU transport for bucket weights.
+
+Weight selection, bucketing, application and versions remain owned by the
+regular BucketWeightSyncer. This transport only bypasses newer c10d helpers
+which are absent in Torch 2.2. It establishes no multi-rank collective support.
+"""
+
+from collections.abc import Mapping
+
+import torch
+
+
+def validate_ray_cpu_sync(cfg, channel, actor_world_size, rollout_world_size):
+    transport = cfg.get("transport", "collective")
+    if transport == "collective":
+        if channel is not None:
+            raise ValueError("weight channel requires explicit transport=ray_cpu")
+        return False
+    if transport != "ray_cpu":
+        raise ValueError(f"Unsupported weight sync transport: {transport}")
+    if actor_world_size != 1 or rollout_world_size != 1:
+        raise ValueError("ray_cpu weight sync currently requires one Actor and one Rollout")
+    if cfg.type != "bucket" or cfg.bucket.bucket_device != "cpu":
+        raise ValueError("ray_cpu requires BucketWeightSyncer with bucket_device=cpu")
+    if channel is None or not getattr(channel, "_use_ray_transport", False):
+        raise ValueError("ray_cpu requires an explicitly created Ray Channel")
+    return True
+
+
+def require_cpu_payload(value):
+    if isinstance(value, torch.Tensor):
+        if value.device.type != "cpu":
+            raise ValueError(f"Ray weight payload must be CPU, got {value.device}")
+    elif isinstance(value, Mapping):
+        for nested in value.values():
+            require_cpu_payload(nested)
+    elif isinstance(value, (tuple, list)):
+        for nested in value:
+            require_cpu_payload(nested)
